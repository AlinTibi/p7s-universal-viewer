<Window x:Class="P7SExtractor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="560" Width="760" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" WindowStyle="None">

    <!-- make the card stretch to available window width (with margin) so buttons have room -->
    <Border Padding="18,18,18,24" Background="#263445" CornerRadius="12" BorderBrush="#3A4A64" BorderThickness="1" Margin="18" HorizontalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: titles -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="lblTitle" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblAppName" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F7" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblVersion" FontSize="13" Foreground="#AEBBD3" Margin="0,4,0,12" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Main content: show all text without requiring scroll -->
            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                    <Border Background="#222D3E" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="txtDescription" Foreground="#E7EDF7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock FontWeight="SemiBold" Foreground="#E7EDF7" Text="Features:" Margin="0,6,0,6"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="feat1" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                                <TextBlock x:Name="feat2" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                                <TextBlock x:Name="feat3" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                                <TextBlock x:Name="feat4" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                                <TextBlock x:Name="feat5" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#222D3E" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="lblUsageTitle" FontWeight="SemiBold" Foreground="#E7EDF7" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtUsage" Foreground="#DDE6F7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            <!-- Footer: buttons always visible -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button x:Name="btnDonateAbout" Style="{StaticResource PrimaryButton}" MinWidth="140" Height="46" Click="BtnDonateAbout_Click" Margin="0,0,12,0" Padding="12,6">
                    Donate
                    <Button.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="2"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="btnCloseAbout" Style="{StaticResource SecondaryButton}" MinWidth="120" Height="46" Click="BtnCloseAbout_Click" Padding="12,6">
                    Close
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
