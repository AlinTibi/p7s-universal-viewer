<Window x:Class="P7SExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="P7S Universal Viewer"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Soft-dark (matte blue-gray), less contrasty and less saturated -->
        <SolidColorBrush x:Key="BrushWindow" Color="#1E293B"/>
        <SolidColorBrush x:Key="BrushCard" Color="#263445"/>
        <SolidColorBrush x:Key="BrushSurface" Color="#243042"/>
        <SolidColorBrush x:Key="BrushSurface2" Color="#222D3E"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#3A4A64"/>

        <SolidColorBrush x:Key="BrushText" Color="#E7EDF7"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#AEBBD3"/>

        <!-- Discrete accent (primary/active only) -->
        <SolidColorBrush x:Key="BrushAccent" Color="#5A8DFF"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="#4D82F2"/>
        <SolidColorBrush x:Key="BrushAccentPressed" Color="#3F72DF"/>

        <SolidColorBrush x:Key="BrushDanger" Color="#EF4444"/>

        <!-- State brushes -->
        <SolidColorBrush x:Key="BrushHover" Color="#2D3A52"/>
        <SolidColorBrush x:Key="BrushPressed" Color="#28354C"/>
        <SolidColorBrush x:Key="BrushRowHover" Color="#2B3850"/>
        <SolidColorBrush x:Key="BrushRowSelected" Color="#324568"/>
        <SolidColorBrush x:Key="BrushRowSelectedBorder" Color="#6A93FF"/>

        <!-- Titles -->
        <Style x:Key="AppTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="{StaticResource BrushAccent}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Global TextBlock default -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F536F"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressed}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F6A98"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#24324A"/>
                                <Setter Property="Foreground" Value="#9AA8C2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushAccentPressed}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPressed}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A4A6A"/>
                    <Setter Property="BorderBrush" Value="#3A4A6A"/>
                    <Setter Property="Foreground" Value="#DDE6F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D2A40"/>
                    <Setter Property="BorderBrush" Value="#3F5677"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A263A"/>
                    <Setter Property="BorderBrush" Value="#4F6A98"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                    <Setter Property="BorderBrush" Value="#24324A"/>
                    <Setter Property="Foreground" Value="#9AA8C2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D2A40"/>
                    <Setter Property="BorderBrush" Value="#3F5677"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A263A"/>
                    <Setter Property="BorderBrush" Value="#4F6A98"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="#24324A"/>
                    <Setter Property="Foreground" Value="#9AA8C2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer / ScrollBar (dark-compatible, subtle) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3F536F"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs: modern segmented-buttons look (Preview) -->
        <Style x:Key="ModernPreviewTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tabs header container -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BrushSurface2}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              Focusable="False"
                                              CanContentScroll="False">
                                    <TabPanel IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Margin="0"
                                              VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Selected content container -->
                            <Border Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Background="{StaticResource BrushSurface2}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem: modern button-like pill with clean centering (Preview) -->
        <Style x:Key="ModernPreviewTabItem" TargetType="TabItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter x:Name="ContentHost"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>

                            <!-- Subtle active indicator (keeps pill intact) -->
                            <Border x:Name="ActiveGlow"
                                    Margin="1"
                                    CornerRadius="9"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5D7D"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2A40"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="ActiveGlow" Property="Background" Value="#15233A"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#24324A"/>
                                <Setter Property="Foreground" Value="#9AA8C2"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPreviewTabHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Preview: custom tabs as buttons (no TabControl/TabItem) -->
        <Style x:Key="PreviewTabButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                                <Border x:Name="ActiveRing"
                                        Margin="1"
                                        CornerRadius="9"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5D7D"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressed}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F6A98"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="ActiveRing" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="ActiveRing" Property="Opacity" Value="0.08"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#24324A"/>
                                <Setter Property="Foreground" Value="#9AA8C2"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid (headers fully visible; trimming only for cells) -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#151E2D"/>
            <Setter Property="AlternatingRowBackground" Value="#141C2A"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A364B"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushRowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushRowSelected}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushRowSelectedBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- Status bar -->
        <Style x:Key="StatusBarBorder" TargetType="Border">
            <Setter Property="Background" Value="#151E2D"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblAppTitle" Style="{StaticResource AppTitle}" Text="P7S Universal Viewer"/>
                    <TextBlock Text="View, verify and extract signed content" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnAbout" Style="{StaticResource GhostButton}" Content="" Click="btnAbout_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnDonate" Style="{StaticResource PrimaryButton}" Content="Donate" Click="btnDonate_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnSettings" Style="{StaticResource SecondaryButton}" Content="Settings" Click="btnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top panels: selection/actions + analyzed info -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblFileSectionTitle" Style="{StaticResource SectionTitle}" Text="File"/>

                    <TextBox x:Name="txtFilePath" Grid.Row="1" Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBrowse" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Choose file" Click="btnBrowse_Click"/>
                        <Button x:Name="btnAnalyze" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Load and analyze" Click="btnAnalyze_Click"/>
                        <Button x:Name="btnClear" Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Reset" Click="btnClear_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblAnalysisDetailsTitle" Style="{StaticResource SectionTitle}" Text="Analysis details"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblDetectedType" Grid.Row="0" Grid.Column="0" Text="Detected type:" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,6"/>
                        <TextBlock x:Name="txtDetectedType" Grid.Row="0" Grid.Column="1" Text="-" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <TextBlock x:Name="lblDetectedExt" Grid.Row="1" Grid.Column="0" Text="Extension:" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,6"/>
                        <TextBlock x:Name="txtDetectedExtension" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,0,0,6" TextWrapping="Wrap"/>

                        <TextBlock x:Name="lblDetectedSize" Grid.Row="2" Grid.Column="0" Text="Size:" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtSize" Grid.Row="2" Grid.Column="1" Text="-" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Middle: batch list + preview -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.9*" MinWidth="500"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3.5*" MinWidth="580"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblLoadedFiles" Style="{StaticResource SectionTitle}" Text="Loaded files"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnLoadFiles" Grid.Column="0" Style="{StaticResource SecondaryButton}" MinWidth="150" Content="Load files" Click="btnLoadFiles_Click"/>
                        <Button x:Name="btnAnalyzeAll" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="150" Content="Analyze all" Click="btnAnalyzeAll_Click"/>
                        <Button x:Name="btnExportCsv" Grid.Column="4" Style="{StaticResource SecondaryButton}" MinWidth="160" Content="Export CSV report" Click="btnExportCsv_Click"/>
                    </Grid>

                    <DataGrid x:Name="dgFiles"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              Margin="10"
                              Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Name}" Width="*" MinWidth="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="MaxHeight" Value="34"/>
                                        <Setter Property="LineHeight" Value="17"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="" Binding="{Binding Type}" Width="140"/>
                            <DataGridTextColumn Header="" Binding="{Binding Size}" Width="95" MinWidth="95"/>
                            <DataGridTextColumn Header="" Binding="{Binding Signature}" Width="130" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnPreviewSelected" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Preview selected" Click="btnPreviewSelected_Click"/>
                        <Button x:Name="btnSaveSelected" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Save selected" Click="btnSaveSelected_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Preview"/>

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource BrushSurface2}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <UniformGrid Rows="1" Columns="5" VerticalAlignment="Center">
                            <Button x:Name="btnPreviewTabPdf" Style="{StaticResource PreviewTabButton}" Content="PDF" Click="PreviewTabPdf_Click"/>
                            <Button x:Name="btnPreviewTabImage" Style="{StaticResource PreviewTabButton}" Content="Image" Click="PreviewTabImage_Click"/>
                            <Button x:Name="btnPreviewTabWord" Style="{StaticResource PreviewTabButton}" Content="Word" Click="PreviewTabWord_Click"/>
                            <Button x:Name="btnPreviewTabArchive" Style="{StaticResource PreviewTabButton}" Content="Archive" Click="PreviewTabArchive_Click"/>
                            <Button x:Name="btnPreviewTabSignature" Style="{StaticResource PreviewTabButton}" Content="Signature" Click="PreviewTabSignature_Click" Margin="0"/>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Background="{StaticResource BrushSurface2}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Grid x:Name="gridPreviewHost">
                                <Grid x:Name="previewTextPanel" Visibility="Collapsed" Background="Transparent">
                                    <TextBox x:Name="txtPreview"
                                             Margin="10"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"/>
                                </Grid>

                                <Grid x:Name="previewArchivePanel" Visibility="Collapsed" Background="Transparent" Margin="-6,-6, -6, -6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="lblArchiveContents" Text="Archive contents:" Margin="10,8" Foreground="{StaticResource BrushTextMuted}"/>
                                    <ListBox x:Name="listArchive"
                                             Grid.Row="1"
                                             Margin="10"
                                             IsSynchronizedWithCurrentItem="True"
                                             HorizontalContentAlignment="Stretch"
                                             SelectionMode="Single"
                                             MouseDoubleClick="listArchive_MouseDoubleClick"/>
                                </Grid>

                                <Grid x:Name="previewPdfPanel" Visibility="Collapsed" Background="Transparent">
                                    <wv2:WebView2 x:Name="pdfViewer" Margin="10"/>
                                </Grid>

                                <ScrollViewer x:Name="previewImagePanel" Visibility="Collapsed">
                                    <Image x:Name="imagePreview" Stretch="Uniform"/>
                                </ScrollViewer>

                                <Grid x:Name="previewExcelPanel" Visibility="Collapsed" Background="Transparent">
                                    <DataGrid x:Name="gridPreview"
                                              Margin="10"
                                              IsReadOnly="True"
                                              AutoGenerateColumns="True"/>
                                </Grid>

                                <Grid x:Name="previewSignaturePanel" Visibility="Collapsed" Background="Transparent">
                                    <TextBox x:Name="txtSignature"
                                             Margin="10"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"/>

                                    <!-- compat: referenced in code-behind -->
                                    <TextBox x:Name="txtSignatureInfo"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Button row: use a WrapPanel inside a ScrollViewer so buttons stay visible
                         on narrow windows (they will wrap to the next line or scroll horizontally). -->
                    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" ItemHeight="40" ItemWidth="Auto" Margin="6,0,6,0">
                            <Button x:Name="btnView" Style="{StaticResource SecondaryButton}" MinWidth="140" Content="View" Click="btnView_Click" Margin="6,0"/>
                            <Button x:Name="btnSave" Style="{StaticResource SecondaryButton}" MinWidth="150" Content="Save content" Click="btnSave_Click" Margin="6,0"/>
                            <Button x:Name="btnOpenExternal" Style="{StaticResource SecondaryButton}" MinWidth="140" Content="Open external" Click="btnOpenExternal_Click" Margin="6,0"/>
                            <Button x:Name="btnSaveTemp" Style="{StaticResource SecondaryButton}" MinWidth="140" Content="Save temp" Click="btnSaveTemp_Click" Margin="6,0"/>
                            <!-- Back button removed per user request; archive tab now returns to listing when selected -->
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="5" Style="{StaticResource StatusBarBorder}" Margin="0,16,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="lblStatusTitle" Text="Status" Foreground="{StaticResource BrushTextMuted}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBlock x:Name="txtStatus"
                           Text="Selecteaza sau trage un fisier .p7s in fereastra."
                           Foreground="{StaticResource BrushText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
