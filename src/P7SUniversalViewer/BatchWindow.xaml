<Window x:Class="P7SUniversalViewer.BatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Batch verification — P7S Universal Viewer"
        Background="#0D1520" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13"
        Width="780" Height="490" MinWidth="550" MinHeight="350" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Batch verification" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Guidance" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button x:Name="OriginalButton" Content="Choose original…" Click="ChooseOriginal" IsEnabled="False"/>
                <Button x:Name="OpenButton" Content="Open details" Click="OpenDetails" IsEnabled="False"/>
                <Button x:Name="ReportButton" Content="Save JSON report…" Click="SaveReport" IsEnabled="False"/>
                <Button Content="Close" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>
        <ListBox x:Name="Results" SelectionChanged="SelectionChanged" AutomationProperties.Name="Batch results">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock Text="{Binding Report.Summary}" DockPanel.Dock="Right" Margin="14,0,0,0"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="{Binding Report.Container}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
