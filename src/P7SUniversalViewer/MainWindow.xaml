<Window x:Class="P7SUniversalViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Background="#0D1520" Foreground="#E8EEF5" FontFamily="Segoe UI" FontSize="13" Title="P7S Universal Viewer — ALMARFELD" Width="1280" Height="760" MinWidth="1000" MinHeight="640" Icon="Assets/p7s.ico" AllowDrop="True" Drop="FileDrop" DragOver="FileDragOver">
<Window.CommandBindings><CommandBinding Command="ApplicationCommands.Open" Executed="OpenClick"/></Window.CommandBindings>
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="ALMARFELD" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="v2.0.0 · Local processing" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="P7S Universal Viewer" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Open. Verify. Extract. Understand P7S files." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Open P7S" Click="OpenClick" ToolTip="Open a CMS / PKCS#7 file"/><Button x:Name="VerifyButton" Content="Verify again" Click="VerifyClick" IsEnabled="False"/><Button x:Name="OriginalButton" Content="Select original file" Click="OriginalClick" Visibility="Collapsed"/><Button x:Name="ExtractButton" Content="Extract to folder" Click="ExtractClick" IsEnabled="False"/><Button x:Name="SaveButton" Content="Save content as…" Click="SaveClick" IsEnabled="False"/></StackPanel>
<Border Grid.Row="2" Background="#192737" CornerRadius="6" Padding="16" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="IntegrityHeader" Text="OPEN A P7S FILE" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="MessageText" Text="Drop a file here or choose Open P7S. Your document stays on this PC." Foreground="{StaticResource Muted}" Margin="0,5,14,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="TrustHeader" Text="Certificate trust: NOT CHECKED"/><TextBlock x:Name="CountHeader" Text="0 signers" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Grid></Border>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Surface}" CornerRadius="6" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="FILE &amp; CONTENT" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="FileNameText" Text="No file selected" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock x:Name="FileInfoText" Foreground="{StaticResource Muted}"/><Separator Margin="0,20,0,16" Background="#33465C"/><TextBlock Text="EMBEDDED CONTENT" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PayloadText" Text="Content appears after inspection." Margin="0,10,0,16"/><Button x:Name="ExternalButton" Content="Open externally" Click="ExternalClick" IsEnabled="False" Margin="0,0,0,14"/><CheckBox x:Name="KeepCheck" Content="Keep temporary previews" Foreground="{StaticResource Muted}" Checked="KeepChanged" Unchecked="KeepChanged"/><TextBlock Text="Certificate checks use local trust stores. Revocation is not checked. A valid signature does not establish legal validity." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border>
<Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="DOCUMENT PREVIEW" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/><Grid Grid.Row="1"><TextBlock x:Name="PreviewNotice" Text="Inspect a signed container to see its original content." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextAlignment="Center" MaxWidth="320"/><TextBox x:Name="TextPreview" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"/><Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform"/><wv:WebView2 x:Name="PdfPreview" Visibility="Collapsed"/></Grid></Grid></Border>
<Border Grid.Column="4" Background="{StaticResource Surface}" CornerRadius="6" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="SIGNATURES &amp; CERTIFICATES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/><ListBox Grid.Row="1" x:Name="SignerList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SignerChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding IntegrityLabel}" FontSize="11" Margin="0,4,0,0" Foreground="#A5D7DC"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" x:Name="SignerStatusText" Margin="0,14,0,12" FontWeight="SemiBold"/><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SignerDetailsText" Text="Every signer is verified independently." Foreground="{StaticResource Muted}" FontSize="12"/></ScrollViewer></Grid></Border>
</Grid><TextBlock Grid.Row="4" Text="No account · No upload · No analytics    |    Windows 10 / 11 x64" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/>
</Grid></Window>
